# Falcon Analytics
# Analítica de fútbol amateur para videos de dron (vista cenial)
# Ejecutable offline en RTX 4070 Laptop
#
# .env de configuración del repositorio

# Modelo YOLO principal (jugadores)
YOLO_MODEL=models/football_weights/yolov8m-640-football-players.pt

# Modelo de pelota (doble pase a alta resolución)
BALL_MODEL=models/football_weights/yolov5m-1280-football-players.pt

# Clasificador de equipos: siglip (recomendado) o hsv
TEAMS_METHOD=siglip
